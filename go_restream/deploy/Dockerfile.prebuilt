# For a small VPS: cross-compile the static Go executable on the build machine.
# CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o deploy/prebuilt/streamdesk ./cmd/tgtv
# Include an exact source archive at deploy/prebuilt/source.tar.gz.
FROM bluenviron/mediamtx:1.19.2 AS mediamtx
FROM debian:bookworm-slim AS native
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev pkg-config libavformat-dev libavcodec-dev libavutil-dev && rm -rf /var/lib/apt/lists/*
COPY deploy/rtmp_sender.c /tmp/rtmp_sender.c
RUN cc -O2 -Wall -Wextra /tmp/rtmp_sender.c -o /rtmp_sender $(pkg-config --cflags --libs libavformat libavcodec libavutil)

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl tini && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 10001 streamdesk && mkdir -p /data/session /data/config /app && chown -R 10001:10001 /data
COPY deploy/prebuilt/streamdesk /usr/local/bin/streamdesk
COPY deploy/prebuilt/source.tar.gz /app/source.tar.gz
COPY --from=native /rtmp_sender /usr/local/bin/rtmp_sender
COPY --from=mediamtx /mediamtx /usr/local/bin/mediamtx
COPY deploy/mediamtx.yml /app/mediamtx.yml
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod 755 /usr/local/bin/entrypoint /usr/local/bin/streamdesk
USER streamdesk
ENV SESSION_DIR=/data/session SESSION_NAME=tgtv CONFIG_DIR=/data/config HTTP_HOST=0.0.0.0 HTTP_PORT=8090 MAX_CONCURRENT_INGESTS=2 IDLE_GRACE_SECONDS=20 FULL_SCAN_INTERVAL_SECONDS=300 LOG_LEVEL=warn RTMP_SENDER=/usr/local/bin/rtmp_sender SOURCE_ARCHIVE=/app/source.tar.gz
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD curl -fsS "http://127.0.0.1:${HTTP_PORT:-8090}/health" || exit 1
ENTRYPOINT ["/usr/bin/tini","--","entrypoint"]
