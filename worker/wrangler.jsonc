{
  "name": "rwitc-racing",
  "main": "src/index.ts",
  "account_id": "eb588e5973f0d75d6c0e7e90b12fb219",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rwitc-telegram",
      "database_id": "b96437ce-2fb6-4a97-9ec4-9b3e720634c5"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "RWITC_API": "https://api.rwitc.com/login",
    "RWITC_ORIGIN": "https://api.rwitc.com"
  }
}
